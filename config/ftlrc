# show latest changed files in current directory and subdirectories, 1 month old, sorted by date, and allow selection via fzf
bind ftl file	"LEADER r l"	show_latest_changes	"show latest changed files"
show_latest_changes()
{
local file="$(latest_changes 'f' "$1" | fzf-tmux $fzf_opt -w 60% -h 70% --ansi -m | tr -s ' ' | sed 's/^[[:space:]]*//' | cut -d' ' -f3- )"
[[ -f "$file" ]] && { cdir "$(dirname "$file")" "$(basename "$file")" ; } || list
}

