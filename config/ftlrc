bind ftl utils	"LEADER r r"	pick_utility	"display a list of utilities to run"
pick_utility()
{
local utility="$(printf "%s\n" "${external_utilities[@]}" | fzf-tmux $fzf_opt -w 60% -h 70% --ansi -m | tr -d ' ' | sed -n 's/^<\([^>]*\)>.*/\1/p')"
[[ "$utility" ]] && { keys_command= REPLY="$utility" ; key_command ; } || list
}

