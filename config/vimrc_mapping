" scooter --------------------------------------------------------------------
set autoread
autocmd FocusGained,BufEnter * checktime

function! Scooter(...) abort
  if a:0 == 0
    " No args → run plain `scooter`
    call RunSilent('scooter')
  else
    " With args → run `scooter arg1 arg2 ...`
    let l:cmd = 'scooter ' . join(a:000, ' ')
    call RunSilent(l:cmd)
  endif
endfunction

command! -nargs=* Scooter call Scooter(<f-args>)

function! VScooter(...) abort
  if a:0 == 0
    call RunSplit('scooter')
  else
    let l:cmd = 'scooter ' . join(a:000, ' ')
    call RunSplit(l:cmd)
  endif
endfunction

command! -nargs=* -bar VScooter call VScooter(<f-args>)

nnoremap <leader>SS :Scooter<CR>
nnoremap <leader>SV :VScooter<CR>
nnoremap <leader>SA :VScooter 

" chose which command to use for scooter, e.g. 'Scooter' or 'VScooter', for the
" bindings below. This allows to easily switch between opening scooter in a
" split or fullscreen without changing the mappings.
let g:scooter_cmd = 'VScooter'

" Open scooter for the current file
nnoremap <leader>SF :execute g:scooter_cmd . ' --config ' . $HOME . '/.config/scooter/vim-config.toml --file-list-height 10 --no-file-filters ' . fnameescape(expand('%'))<CR>

" Open scooter for all files in the current git repo
nnoremap <leader>SG :execute g:scooter_cmd . ' --config ' . $HOME . '/.config/scooter/vim-config.toml ' . trim(system('git rev-parse --show-toplevel'))<CR>

" Open scooter with visual selection as the search text
" Visual: use selection as search text
vnoremap <leader>SV :<C-U>execute g:scooter_cmd . ' --config ' . $HOME .  '/.config/scooter/vim-config.toml --file-list-height 10 --fixed-strings --no-file-filters --editable --search-text ' . fnameescape(@")<CR>

" Normal: use word under cursor as search text
nnoremap <leader>SW :execute g:scooter_cmd . ' --config ' . $HOME . '/.config/scooter/vim-config.toml --file-list-height 10 --editable --no-file-filters --fixed-strings --search-text ' . fnameescape(expand('<cword>'))<CR>

